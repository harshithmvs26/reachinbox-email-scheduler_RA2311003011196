{
  "name": "outbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox Assignment Backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "render-build": "prisma generate && prisma db push && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@bull-board/api": "^5.15.1",
    "@bull-board/express": "^5.15.1",
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "^5.12.1",
    "bullmq": "^5.7.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "axios": "^1.6.8",
    "prisma": "^5.12.1",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "ts-node-dev": "^2.0.0"
  }
}
