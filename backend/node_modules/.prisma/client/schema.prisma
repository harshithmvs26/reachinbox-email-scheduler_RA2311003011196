generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  slackToken   String?
  slackWebhook String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emails       Email[]
}

model Email {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  toEmail      String
  subject      String
  body         String
  status       EmailStatus @default(SCHEDULED)
  scheduledAt  DateTime
  sentAt       DateTime?
  failedReason String?
  bullJobId    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

enum EmailStatus {
  SCHEDULED
  SENT
  FAILED
}
